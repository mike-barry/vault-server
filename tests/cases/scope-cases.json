  { "name": "unscoped grant allows anything", "vault": "primary", "path": "Areas/Personal/Health.md", "scopeRoots": { "primary": [] }, "outcome": "inScope" },
  { "name": "path directly under a single-segment root", "vault": "primary", "path": "Projects/Widget/Widget.md", "scopeRoots": { "primary": ["Projects"] }, "outcome": "inScope" },
  { "name": "path directly under a multi-segment root", "vault": "primary", "path": "Projects/Vault-MCP-Server/Corpus/Server-Structure.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server"] }, "outcome": "inScope" },
  { "name": "path equal to the root plus one segment", "vault": "primary", "path": "Projects/Vault-MCP-Server/Tasks.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server"] }, "outcome": "inScope" },
  { "name": "path under a different top-level folder is out of scope", "vault": "primary", "path": "Areas/Personal/Health.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server"] }, "outcome": "outOfScope" },
  { "name": "sibling folder sharing a string prefix is out of scope", "vault": "primary", "path": "Projects/Vault-MCP-Server-Old/Notes.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server"] }, "outcome": "outOfScope" },
  { "name": "note whose name string-prefixes the root but sits outside it is out of scope", "vault": "primary", "path": "Projects/Vault-MCP-Server.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server"] }, "outcome": "outOfScope" },
  { "name": "path matches when any of several roots contains it", "vault": "primary", "path": "Areas/Homelab/Servers.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server", "Areas/Homelab"] }, "outcome": "inScope" },
  { "name": "path matches none of several roots", "vault": "primary", "path": "Areas/Personal/Health.md", "scopeRoots": { "primary": ["Projects/Vault-MCP-Server", "Areas/Homelab"] }, "outcome": "outOfScope" },
  { "name": "case-insensitive segment match", "vault": "primary", "path": "projects/WIDGET/widget.md", "scopeRoots": { "primary": ["Projects/Widget"] }, "outcome": "inScope" },
  { "name": "backslash-separated path normalizes the same as forward-slash", "vault": "primary", "path": "Projects\\Widget\\Widget.md", "scopeRoots": { "primary": ["Projects/Widget"] }, "outcome": "inScope" },
  { "name": "root with a trailing dot-dot that stays inside the vault normalizes cleanly", "vault": "primary", "path": "Projects/Widget/Widget.md", "scopeRoots": { "primary": ["Projects/Foo/../Widget"] }, "outcome": "inScope" },
  { "name": "root that escapes the vault is unscopeable", "vault": "primary", "path": "Projects/Widget/Widget.md", "scopeRoots": { "primary": ["../outside"] }, "outcome": "invalid" },
