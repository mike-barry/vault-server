<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compiles to vault.exe. UseAppHost is left at its default rather than set: the server sets it
         false and the CLI needs an executable, so the two projects differ here on purpose. -->
    <AssemblyName>vault</AssemblyName>
    <!-- Without this, RootNamespace follows AssemblyName and every file would default to `vault`. -->
    <RootNamespace>VaultCli</RootNamespace>
    <!-- Generating the documentation file turns on the XML doc warnings. CS1591 stays off, because
         an undocumented member is not the concern; CS1573, which fires when a documented member
         leaves one of its parameters undocumented, is, and so is malformed XML. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CLI's own configuration, read from beside the executable. -->
    <None Update="vault.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultShared\VaultShared.csproj" />
  </ItemGroup>

</Project>
