{
  // The CLI's own configuration, read from beside vault.exe. Relative paths resolve against this
  // file's own directory, never the working directory the CLI was run from.

  // The named grant every invocation runs as, unless --grant overrides it. It is an ordinary
  // token-less row in grants.json carrying "named": true - no id is special-cased in code, so
  // re-pointing this default is one edit here. Absence fails the invocation. There is no path from
  // a missing value to authority.
  "GrantId": "admin",

  // The same three files the server loads, named here so a CLI run away from the server can still
  // find them. These point at the repository root from the build output directory,
  // bin/<config>/<tfm>. publish.ps1 installs vault.settings.deployed.json over this file, because
  // bin\vault sits at a different distance from the repository root than the build output does.
  "OpClassesConfigPath": "../../../../../op-classes.json",
  "VaultsConfigPath": "../../../../../vaults.json",
  "GrantsConfigPath": "../../../../../grants.json",

  // Where ripgrep is. Unset means rg as PATH resolves it. A path set here that is not on disk is
  // reported by the health check and refuses glob and grep; every other tool keeps working.
  "RipgrepPath": ""
}
