<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <!-- Generating the documentation file turns on the XML doc warnings. CS1591 stays off, because
         an undocumented member is not the concern; CS1573, which fires when a documented member
         leaves one of its parameters undocumented, is, and so is malformed XML. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0-preview.3" />
    <!-- Direct pin over the vulnerable 10.0.6 pulled transitively by Microsoft.PowerShell.SDK (NU1903); NU1510 is wrong that it's removable -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultShared\VaultShared.csproj" />
  </ItemGroup>

</Project>
