{
  "admin": {
    "named": true,
    "id": "admin",
    "opClasses": ["*"],
    "vaults": ["*"],
    "ttl": "*",
    "scopeRoots": { "*": ["*"] }
  },
  "REPLACE-WITH-A-LONG-RANDOM-READONLY-TOKEN": {
    "id": "read-only",
    "opClasses": ["content:read"],
    "vaults": ["test"],
    "ttl": "*",
    "scopeRoots": { "test": ["*"] }
  },
  "REPLACE-WITH-A-LONG-RANDOM-SCOPED-TOKEN": {
    "id": "scoped-example",
    "opClasses": ["content:read"],
    "vaults": ["test"],
    "ttl": "*",
    "scopeRoots": { "test": ["Projects/Widget", "Resources"] },
    "canRequestElevation": true
  },
  "REPLACE-WITH-A-LONG-RANDOM-MULTI-VAULT-SCOPED-TOKEN": {
    "id": "multi-vault-scoped-example",
    "opClasses": ["content:read"],
    "vaults": ["test", "REPLACE-WITH-A-SECOND-VAULT-NAME"],
    "ttl": "*",
    "scopeRoots": { "test": ["*"], "REPLACE-WITH-A-SECOND-VAULT-NAME": ["Areas"] }
  }
}
